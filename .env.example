# ==============================
# App
# ==============================
NODE_ENV=development
PORT=5000
API_VERSION=v1
CLIENT_URL=http://localhost:3000

# ==============================
# Database (PostgreSQL + Sequelize)
# ==============================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trustlend_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_DIALECT=postgres
# Set to true only if your provider requires SSL (e.g. hosted Postgres like Neon/Render)
DB_SSL=false

# ==============================
# JWT
# ==============================
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==============================
# Bcrypt
# ==============================
BCRYPT_SALT_ROUNDS=10

# ==============================
# Redis (caching + BullMQ)
# ==============================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==============================
# Cloudinary (image storage)
# ==============================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==============================
# Paystack (primary payments)
# ==============================
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ==============================
# Flutterwave (backup payments)
# ==============================
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# ==============================
# Google Maps (location / distance)
# ==============================
GOOGLE_MAPS_API_KEY=

# ==============================
# Resend (email)
# ==============================
RESEND_API_KEY=
EMAIL_FROM="TrustLend <no-reply@yourdomain.com>"

# ==============================
# Firebase Cloud Messaging (push notifications)
# ==============================
# Path to the downloaded Firebase service account JSON (kept OUT of git)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
